+
+# Only original show_result finalizes the three-stage standard RUN.
+func _record_allowed() -> bool:
+	return not test_mode and not record_debug_excluded
+
+func _record_load() -> void:
+	var old := ConfigFile.new()
+	var error := old.load("user://task_heaven.cfg")
+	if error == ERR_FILE_NOT_FOUND:
+		record_bridge.legacy_best("game013", -1)
+	elif error != OK:
+		record_bridge.storage_error("game013")
+	else:
+		var legacy: Variant = old.get_value("game", "best", null)
+		if typeof(legacy) == TYPE_INT and legacy >= 0:
+			record_bridge.legacy_best("game013", legacy)
+		else:
+			record_bridge.storage_error("game013")
+	var current := current_record_save.load_best("game013.normal.r1", 11400)
+	if current.status == "error":
+		record_bridge.storage_error("game013")
+	else:
+		record_bridge.current_best("game013", current.value)
+
+func _record_finish() -> void:
+	if not record_active or record_finished or not _record_allowed(): return
+	record_finished = true
+	record_active = false
+	var mode := "ojt" if record_ojt_used else "normal"
+	var saved := current_record_save.save_best("game013.%s.r1" % mode, scoring.score, 11400)
+	if saved.status == "error": record_bridge.storage_error("game013")
+	record_bridge.finish_run("game013", record_result_id, scoring.score, "1", mode)
